# ==================================================
# CONFIGURAÇÕES DA API INHIRE
# ==================================================
INHIRE_BASE_URL=https://api.inhire.app/
INHIRE_AUTH_URL=https://auth.inhire.app/
INHIRE_EMAIL=seu-service-account@inhire.app
INHIRE_PASSWORD=sua_senha_aqui
INHIRE_TENANT=seu_tenant

# Timeouts (em segundos)
INHIRE_TIMEOUT_CONNECT=15
INHIRE_TIMEOUT_READ=45
INHIRE_TIMEOUT_WRITE=45
INHIRE_TIMEOUT_TOTAL=90

# Rate Limiting
INHIRE_MAX_REQUESTS_PER_MINUTE=1000
INHIRE_RETRY_ATTEMPTS=3
INHIRE_RETRY_BACKOFF_FACTOR=2.0

# ==================================================
# CONFIGURAÇÕES DO BANCO DE DADOS POSTGRESQL
# ==================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inhire_sync
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# Pool de conexões
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# SSL
DB_SSL_MODE=prefer

# ==================================================
# CONFIGURAÇÕES DE SINCRONIZAÇÃO
# ==================================================
SYNC_ENABLED=true
SYNC_VAGAS_ENABLED=true
SYNC_POSICOES_ENABLED=true
SYNC_CANDIDATURAS_ENABLED=true
SYNC_TALENTOS_ENABLED=true

# Frequências (minutos/horas)
SYNC_INCREMENTAL_FREQUENCY_MINUTES=60
SYNC_FULL_FREQUENCY_HOURS=24

# Paginação
SYNC_BATCH_SIZE=50
SYNC_MAX_PAGES=

# Concorrência
SYNC_MAX_CONCURRENT_SYNCS=3
SYNC_MAX_WORKERS=5

# ==================================================
# OTIMIZAÇÕES DE TIMELINE (08/01/2026)
# ==================================================
# Filtro inteligente: Processa apenas candidaturas modificadas após última sync
# TIMELINE_DAYS_LOOKBACK: Usado apenas na primeira sincronização (fallback)
# TIMELINE_MAX_WORKERS: Threads paralelas (10x mais rápido)

# Fallback para primeira sincronização (padrão: 30 dias)
TIMELINE_DAYS_LOOKBACK=30

# Threads paralelas para timeline (recomendado: 5-20)
# 5 = Conservador (menos carga no servidor)
# 10 = Balanceado (padrão recomendado)
# 20 = Turbo (máxima performance)
TIMELINE_MAX_WORKERS=10

# ==================================================
# CONFIGURAÇÕES DO SCHEDULER
# ==================================================
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Sao_Paulo
SCHEDULER_FULL_SYNC_HOUR=2
SCHEDULER_FULL_SYNC_MINUTE=0

# ==================================================
# CONFIGURAÇÕES DE LOGGING
# ==================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/inhire_sync.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# ==================================================
# NOTIFICAÇÕES (OPCIONAL)
# ==================================================
NOTIFICATIONS_ENABLED=false
NOTIFICATION_EMAIL=
NOTIFICATION_WEBHOOK_URL=

# ==================================================
# INTEGRAÇÃO GOOGLE SHEETS
# ==================================================
# Caminho para o arquivo de credenciais da Service Account
# https://console.cloud.google.com/
GOOGLE_CREDENTIALS_PATH=credentials/google_service_account.json

# ID da planilha para exportar posições
# Extrair da URL: https://docs.google.com/spreadsheets/d/ABC123XYZ/edit
#                                                      ^^^^^^^^^
GOOGLE_SHEETS_POSICOES_ID=

# ==================================================
# AMBIENTE
# ==================================================
ENVIRONMENT=production
DEBUG=false
